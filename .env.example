# AgentRouter LLM Settings
AGENTROUTER_API_KEY="sk_your_agentrouter_api_key_here"
AGENTROUTER_BASE_URL="https://agentrouter.org/v1"
AGENTROUTER_MODEL="deepseek-v4-flash"

# WooCommerce REST API Credentials
WC_SITE_URL="https://kiachahiye.com"
WC_CONSUMER_KEY="ck_your_woocommerce_consumer_key"
WC_CONSUMER_SECRET="cs_your_woocommerce_consumer_secret"
WC_VERIFY_SSL="true"

# Rate Limiting & Delays (Seconds)
DELAY_BETWEEN_REVIEWS_MIN="1.5"
DELAY_BETWEEN_REVIEWS_MAX="2.5"
DELAY_BETWEEN_PRODUCTS_MIN="3.5"
DELAY_BETWEEN_PRODUCTS_MAX="5.0"
